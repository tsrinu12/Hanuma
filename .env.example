# =====================================================================
# distrebute.com - AI Video Platform - Environment Variables
# Copy to .env and fill in real values. Do NOT commit .env to git.
# =====================================================================

# --- AWS / Region ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# --- S3 (production) / MinIO (local dev) ---
# In prod, point S3_ENDPOINT_URL to "" (empty) to use AWS S3.
# In local dev, point to http://minio:9000.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_RAW=distribute-raw-uploads
S3_BUCKET_HLS=distribute-hls-public
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- CloudFront (prod) ---
CLOUDFRONT_DOMAIN=

# --- Postgres / RDS ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=distribute
POSTGRES_USER=distribute
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://distribute:changeme@postgres:5432/distribute

# --- Redis (queue + cache) ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant (vector DB) ---
QDRANT_URL=http://qdrant:6333

# --- Keycloak (auth) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=distribute
KEYCLOAK_CLIENT_ID=distribute-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- AI: speech / summary ---
WHISPER_MODEL=large-v3        # tiny | base | small | medium | large-v3 | turbo
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
OPENAI_API_KEY=               # optional; if blank, ai-service uses local HF models
SUMMARY_MODEL=facebook/bart-large-cnn
AI_WORKER=1                   # 1 = run background worker thread in ai-service

# --- V-JEPA (video understanding) ---
VJEPA_MODEL=facebook/vjepa2-vitl-fpc64-256
VJEPA_CLASSIFIER_MODEL=facebook/vjepa2-vitl-fpc64-256-ssv2
VJEPA_FRAMES=64
VJEPA_IMAGE_SIZE=256
VJEPA_EMBED_DIM=1024
VJEPA_COLLECTION=vjepa_videos
METADATA_URL=http://metadata-service:8000  # vjepa-service calls metadata to enrich

# --- Translation (NLLB-200) ---
NLLB_MODEL=facebook/nllb-200-3.3B
LANG_ID_MODEL=facebook/fasttext-language-identification
MAX_INPUT_TOKENS=1024
TRANSLATE_BATCH_SIZE=8

# --- NLP (topic, NER, zero-shot) ---
NER_MODEL=dslim/bert-large-NER
ZEROSHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
MAX_TOPICS=10
DEVICE=cuda                    # cuda | cpu

# --- Spam / moderation ---
TOXIC_MODEL=unitary/toxic-bert
HATE_MODEL=Hate-speech-CNERG/dehatebert-mono-english
MAX_CAPS_RATIO=0.6
MAX_EMOJI_RATIO=0.4
MAX_REPEAT_RUN=6
MAX_URLS=2
RATE_MAX=8                     # max actions per RATE_WINDOW seconds
RATE_WINDOW=60

# --- Gamification (points / streaks) ---
POINTS_VIEW=1
POINTS_COMPLETE=5
POINTS_LIKE=2
POINTS_COMMENT=2
POINTS_SHARE=3
POINTS_UPLOAD=10
POINTS_FIRST_VIEW_OF_DAY=10
POINTS_STREAK_BONUS=2
MIN_VIEW_FRACTION=0.10         # min watched fraction to count as a "view"
MIN_COMPLETE_FRACTION=0.85     # min watched fraction to count as a "complete"
DEDUPE_WINDOW=3600             # unique-view dedupe window, seconds
